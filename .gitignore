*.jl.cov
*.jl.*.cov
*.jl.mem
# Resolved manifests are environment-specific and regenerated by Pkg; never
# commit them (a stale committed manifest silently pins old dep versions).
# Matches Manifest.toml in every environment (root workspace, test/, docs/,
# test/jet/, test/enzyme/, test/formatter/, scripts/).
Manifest.toml
/docs/build/
/docs/src/analysis.md
/docs/src/index.md
/docs/src/references.md
/docs/src/summary_assets/
/docs/node_modules/
/output/
.DS_Store
.claude/
CLAUDE.md
.ipynb_checkpoints/
*.swp
*.swo

# SitRep PDFs fetched by scripts/download_sitreps.jl for scanning
/data/sitrep_pdfs/

# Scratch diagnostic harness (throwaway, not part of the package)
/scratch/

# TensorBoard streaming logs from the diagnostic fit scripts
/logs/
logs/

# Transient run logs and result dumps from the diagnostic fit scripts
/scripts/out/*.log
/scripts/out/*.txt

*.html

# Transient docs build logs captured at the repo root
/docs_build*.log
