*.jl.cov
*.jl.*.cov
*.jl.mem
# Resolved manifests are environment-specific and regenerated by Pkg; never
# commit them (a stale committed manifest silently pins old dep versions).
# Matches Manifest.toml in every environment (root workspace, test/, docs/,
# test/jet/, test/enzyme/, test/formatter/, scripts/).
Manifest.toml
/docs/build/
/docs/src/index.md
/docs/src/estimates/national.md
/docs/src/estimates/province.md
/docs/src/forecasts/
/docs/src/evaluation/
/docs/src/sensitivity.md
# Figures a local Literate render writes beside the page markdown
/docs/src/**/*-[0-9]*.png
/docs/src/references.md
/docs/src/summary_assets/
/docs/node_modules/
/output/
.DS_Store
.claude/
CLAUDE.md
.ipynb_checkpoints/
*.swp
*.swo

# SitRep PDFs fetched by scripts/download_sitreps.jl for scanning.
# No trailing slash: in a worktree the cache is usually a symlink back to the
# primary checkout, and a directory-only pattern would not match the symlink,
# letting it be committed with an absolute path that dangles everywhere else.
/data/sitrep_pdfs
__pycache__/

# Scratch diagnostic harness (throwaway, not part of the package)
/scratch/

# One-off harnesses written at the repository root rather than in scratch/.
# Anchored to the root so that scripts/bench_*.jl stays tracked.
/run_*.jl
/bench_*.jl

# TensorBoard streaming logs from the diagnostic fit scripts
/logs/
logs/

# Transient run logs and result dumps from the diagnostic fit scripts
/scripts/out/*.log
/scripts/out/*.txt

# Saved benchmark results. `task benchmark` writes results.json to the
# working directory; the numbers are machine-specific and are compared
# between two runs, never stored.
/results.json

# `task benchmark-pair` writes both arms' results here and checks the two
# revisions out under .benchmark-worktrees/.
/benchmark-results/
/.benchmark-worktrees/

*.html

# Transient docs build logs captured at the repo root
/docs_build*.log
.pi-subagents/

# Per-release worktrees created by scripts/backfill_forecasts.jl (--keep)
/worktrees/
